# Copy this file to .env and replace only the credentials you use.
# Never commit the populated .env file.

GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
PINECONE_API_KEY=
HF_TOKEN=

GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_MODEL=gpt-oss-120b
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENROUTER_MODEL=openai/gpt-4o-mini
BEDROCK_MODEL=meta.llama3-3-70b-instruct-v1:0
GROQ_FAST_MODEL=openai/gpt-oss-120b
CEREBRAS_FAST_MODEL=llama3.1-8b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENROUTER_FAST_MODEL=qwen/qwen-2.5-7b-instruct
BEDROCK_FAST_MODEL=us.meta.llama3-1-8b-instruct-v1:0

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_ORDER=cerebras,groq,nvidia,openrouter
FAST_LLM_TIMEOUT=15
PRIMARY_LLM_TIMEOUT=45
BEDROCK_ENABLED=false
AWS_BEDROCK_REGION=us-east-1

PINECONE_INDEX_NAME=agentic-rag-hybrid
POSTGRES_URL=postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable

EMBEDDING_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_DEVICE=auto
CROSS_ENCODER_BATCH_SIZE=32
CHUNK_SIZE=240
CHUNK_OVERLAP=40
MAX_RETRIES=2
MAX_HISTORY_MESSAGES_FOR_GENERATION=2
MAX_GENERATION_CONTEXT_DOCUMENTS=5
MAX_GENERATION_CONTEXT_CHARS=12000
MAX_GENERATION_OUTPUT_CHARS=12000

HYBRID_ALPHA=0.5
HYBRID_CANDIDATE_K=15
RRF_K=60
RERANK_TOP_K_CONTENT=5
RERANK_TOP_K_OVERVIEW=2
RETRIEVAL_MIN_TOP_SCORE=0.30
RETRIEVAL_STRONG_TOP_SCORE=0.60
RETRIEVAL_TOP_TO_MEAN_RATIO=1.10
RETRIEVAL_GAP_RATIO=0.02
RETRIEVAL_OVERVIEW_MARGIN=0.02

DEBUG=false
RETRIEVAL_LOGS=true
LLM_LOGS=true
PERFORMANCE_LOGS=true
GRAPH_LOGS=false
LLM_MAX_RETRIES_PER_PROVIDER=3
LLM_RETRY_BASE_DELAY_SECONDS=2
